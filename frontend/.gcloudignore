# Ignore node_modules and Next.js build cache from Cloud Build uploads
node_modules/
.next/
.git/
.gitignore
.env.local
.env.development

# .env.production is intentionally NOT excluded — it holds only public
# NEXT_PUBLIC_* build-time values and must reach the Docker build context,
# otherwise Next.js bakes in an undefined NEXT_PUBLIC_API_URL and the whole
# frontend loses backend connectivity (this broke production once already).
