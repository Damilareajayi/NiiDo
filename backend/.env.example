# ============================================
# NiiDo Backend — Environment Variables
# Copy to .env and fill in real values
# ============================================

PORT=4000
NODE_ENV=development

# --- Firebase Admin SDK ---
# Download from Firebase Console → Project Settings → Service Accounts
# → Generate New Private Key → save as firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_PROJECT_ID=your_project_id

# --- Google Gemini AI ---
# Get from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# --- EduPrompt Lesson Plan API (LearnScape) ---
# Preferred lesson generator for NiiDo Teach — falls back to Gemini above if unset or unavailable.
# Get a key via an EduPrompt admin's /api/admin/create-key endpoint.
EDUPROMPT_API_KEY=ep_your_api_key
EDUPROMPT_BASE_URL=https://eduprompt.learnscape.africa

# --- WhatsApp (Twilio) ---
# Or use Meta WhatsApp Business API directly
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Frontend URL (for CORS) ---
FRONTEND_URL=http://localhost:3000

# --- App ---
APP_SECRET=change_this_to_a_random_secret_string
